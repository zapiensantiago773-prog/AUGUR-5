      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/mac-debug/plugin/Augur5_artefacts/Debug/Standalone/AUGUR-5.app/Contents/MacOS/AUGUR-5",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "AUGUR: build"
    },
    {
      "name": "DSP tests (macOS, Debug)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/mac-debug/tests/augur_tests",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "AUGUR: build"
