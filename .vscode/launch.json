      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "AUGUR: build"
    },
    {
      "name": "DSP tests (Windows, Debug)",
      "type": "cppvsdbg",
      "request": "launch",
