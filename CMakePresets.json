{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "win-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    { "name": "win-debug",   "displayName": "Windows Debug (MSVC x64)",   "inherits": "win-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "win-release", "displayName": "Windows Release (MSVC x64)", "inherits": "win-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "mac-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    { "name": "mac-debug",   "displayName": "macOS Debug (universal)",   "inherits": "mac-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "mac-release", "displayName": "macOS Release (universal)", "inherits": "mac-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "win-debug",   "configurePreset": "win-debug" },
    { "name": "win-release", "configurePreset": "win-release" },
    { "name": "mac-debug",   "configurePreset": "mac-debug" },
    { "name": "mac-release", "configurePreset": "mac-release" }
  ],
  "testPresets": [
    { "name": "win-debug",   "configurePreset": "win-debug",   "output": { "outputOnFailure": true } },
    { "name": "win-release", "configurePreset": "win-release", "output": { "outputOnFailure": true } },
    { "name": "mac-debug",   "configurePreset": "mac-debug",   "output": { "outputOnFailure": true } },
    { "name": "mac-release", "configurePreset": "mac-release", "output": { "outputOnFailure": true } }
  ]
}
